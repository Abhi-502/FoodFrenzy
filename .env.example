# FoodFrenzy Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment environment

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/foodfrenzy?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8080

# Initial Admin Credentials (used during DB seeding)
APP_ADMIN_EMAIL=admin@foodfrenzy.com
APP_ADMIN_PASSWORD=Admin@12345
